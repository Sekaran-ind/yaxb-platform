# /etc/yaxb-box/yaxb-box.env -- read by yaxb-box.service and litestream.service.
# install.sh copies this once and generates the token; edit the copy, then:
#   sudo systemctl restart yaxb-box litestream

# Devices use the box with this token (Settings -> Storage -> Box in the kiosk). At least 32 characters.
YAXB_BOX_TOKEN=

# Kiosk origins allowed to use the box from a browser, space or comma separated, e.g.
#   http://localhost:3000 https://yaxb-web.<your-account>.workers.dev
YAXB_BOX_ORIGINS=http://localhost:3000

YAXB_BOX_DB=/var/lib/yaxb-box/yaxb-box.sqlite3
YAXB_BOX_TLS_CERT=/etc/yaxb-box/tls/cert.pem
YAXB_BOX_TLS_KEY=/etc/yaxb-box/tls/key.pem
YAXB_BOX_PORT=47870
YAXB_BOX_CERT_PORT=47871

# Litestream's replica: a folder on a USB drive or NFS share mounted here. It must be a different
# disk from the SD card -- a copy on the same card is lost with the card.
YAXB_BACKUP_DIR=/mnt/yaxb-backup
