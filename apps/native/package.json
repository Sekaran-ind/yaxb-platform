{
  "name": "@sekaran-ind/yaxb-native",
  "version": "0.1.0",
  "private": true,
  "description": "The YAXB kiosk as a native Android and iOS app (Capacitor), built from apps/web in native mode. Opens straight into the kiosk.",
  "scripts": {
    "build": "npm run build:native -w @sekaran-ind/yaxb-web && cap sync",
    "sync": "cap sync",
    "android": "cap open android",
    "ios": "cap open ios",
    "run:android": "cap run android"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "7.0.1",
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0"
  }
}
