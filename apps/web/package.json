{
  "name": "@sekaran-ind/yaxb-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "The YAXB web surface: a Vue single-page app served as Workers static assets, and a Hono Worker for the API (yaxb-core's agent).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "vue-tsc -b",
    "lint": "eslint .",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply yaxb --local",
    "db:migrate:remote": "wrangler d1 migrations apply yaxb --remote"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@lucide/vue": "1.71.0",
    "@sekaran-ind/yaxb-core": "0.1.0",
    "hono": "4.13.17",
    "pdfjs-dist": "6.5.438",
    "vue": "3.5.45",
    "vue-router": "4.6.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.68.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.19.1",
    "@vitejs/plugin-vue": "6.0.10",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "10.12.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14",
    "wrangler": "4.159.0"
  }
}
