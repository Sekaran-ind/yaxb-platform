{
  "name": "yaxb-platform",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build:core": "npm run build -w @sekaran-ind/yaxb-journeys && npm run build -w @sekaran-ind/yaxb-core",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  }
}
